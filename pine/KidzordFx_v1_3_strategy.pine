maxBars    = input.int(120, "Закрыть по времени, баров", minval = 5, group = gTrade)
reEntryBars = input.int(10, "Кулдаун после выхода, баров", minval = 0, maxval = 200, group = gTrade)
tpMode    = input.string("Лестница до цели", "Цели TP", options = ["Лестница до цели", "R-множители"], group = gTrade, tooltip = "Лестница: TP1/TP2/TP3 = 50/75/100% пути до проверенной цели из строки 8. R-множители: фиксированные 1/2/3R, как в V1.2.")
trailMode = input.string("Нет", "Трейлинг после TP1", options = ["Нет", "ATR", "Свинг"], group = gTrade)
trailAtr  = input.float(1.5, "Трейлинг: ATR-множитель", minval = 0.5, step = 0.1, group = gTrade)
trailSwingLen = input.int(5, "Трейлинг: свинг, баров", minval = 2, maxval = 50, group = gTrade)
maxTradesDay  = input.int(0, "Лимит сделок в день (0 = нет)", minval = 0, maxval = 50, group = gTrade)
simSpread = input.float(0.0, "Симуляция: спред, пунктов", minval = 0.0, step = 0.1, group = gVal, tooltip = "Вычитается из R в таблице статистики. 1 пункт = syminfo.mintick.")
alertJson = input.bool(true, "Алерт в JSON (для бота)", group = gVal, tooltip = "JSON-формат разбирает parse_alert в app.py. Выключено — старый текстовый формат.")
simCommR  = input.float(0.0, "Симуляция: комиссия, R", minval = 0.0, step = 0.01, group = gVal)
tblPos    = input.string("Верх-право", "Позиция таблицы чек-листа", options = ["Верх-право", "Верх-лево", "Низ-право", "Низ-лево"], group = gTbl)
showTbl   = input.bool(true, "Показывать чек-лист", group = gTbl)
showZone  = input.bool(true, "Показывать зону EMA200 старшего ТФ", group = gTbl)
showLtfE  = input.bool(true, "Показывать EMA рабочего ТФ", group = gTbl)
showMarks = input.bool(true, "Метки сигналов", group = gTbl)
showTL    = input.bool(true, "Наклонные линии по экстремумам", group = gTbl)
pivL      = input.int(5, "Пивот: баров слева", minval = 1, maxval = 100, group = gTbl)
pivR      = input.int(5, "Пивот: баров справа", minval = 1, maxval = 100, group = gTbl)
tlCount   = input.int(3, "Сколько линий на сторону", minval = 1, maxval = 20, group = gTbl)
tlExtend  = input.bool(true, "Продлевать вправо", group = gTbl)
showEma50 = input.bool(false, "Показывать EMA 50", group = gTbl)
showHtfEma = input.bool(true, "Показывать EMA200 контекста", group = gTbl)
showDEma = input.bool(false, "Показывать EMA200 дневную", group = gTbl)
showPd   = input.bool(true, "Premium/Discount: диапазон и равновесие", group = gTbl)
showOb   = input.bool(true, "Рисовать Order Blocks", group = gTbl)
showEq   = input.bool(true, "Рисовать EQH/EQL", group = gTbl)
showKz   = input.bool(true, "Рисовать killzone-боксы", group = gKz)
kzLondon = input.bool(true, "Лондон 02:00–05:00", group = gKz)
kzNyAm   = input.bool(true, "NY AM 07:00–10:00", group = gKz)
kzNyPm   = input.bool(true, "NY PM 13:30–16:00", group = gKz)
kzAsia   = input.bool(false, "Азия 20:00–00:00", group = gKz)
showMtf  = input.bool(true, "Дашборд старших ТФ", group = gDash)
mtfTf1   = input.timeframe("15", "Дашборд ТФ 1", group = gDash)
mtfTf2   = input.timeframe("60", "Дашборд ТФ 2", group = gDash)
mtfTf3   = input.timeframe("240", "Дашборд ТФ 3", group = gDash)
mtfTf4   = input.timeframe("D", "Дашборд ТФ 4", group = gDash)
showDiag  = input.bool(true, "Таблица диагностики (частота условий)", group = gTbl)
theme     = input.string("Графит + золото", "Тема оформления", options = ["Графит + золото", "Тёмный минимал", "Светлый премиум"], group = gTbl)
diagLen   = input.int(500, "Окно диагностики, баров", minval = 50, maxval = 5000, group = gTbl)
tlMode    = input.string("Канал", "Тип линий по экстремумам", options = ["Канал", "Веер"], group = gTbl)
// UDT уровня: один объект на уровень, поля мутируются на каждом баре.
// kind: 1 = сопротивление, -1 = поддержка, 0 = оба; prio: 10 ручной, 5 PD/PW, 3 ON/IB
type Lvl
    string nm
    float  px
    bool   act
    int    kind
    int    prio
    int    touchS
    int    rejectS
    int    touchL
    int    rejectL
    bool   inBand
// Order Block: зона последней противоположной свечи перед импульсом.
type OB
    float top
    float bot
    int   dir
    int   bar
// доли TP: защита от суммы > 100% (иначе статистика начисляет невозможные R)
int p1PctSafe = int(math.max(0.0, math.min(100.0, p1Pct)))
int p2PctSafe = int(math.max(0.0, math.min(100.0 - p1PctSafe, p2Pct)))
int p3PctSafe = 100 - p1PctSafe - p2PctSafe
float p1Frac = p1PctSafe / 100.0
float p2Frac = p2PctSafe / 100.0
// ──────────────────────── РЕЕСТР УРОВНЕЙ ────────────────────────
// Уровни живут в одном массиве объектов: при смене дня/недели/сессии
// сбрасываются только касания этого уровня, а не вся история.
f_initLV() =>
    array<Lvl> res = array.new<Lvl>()
    for i = 0 to 12
        int k  = i <= 4 ? 0 : (i == 5 or i == 7 or i == 9 or i == 11) ? 1 : -1
        int pr = i <= 4 ? 10 : i <= 8 ? 5 : 3
        array.push(res, Lvl.new("", 0.0, false, k, pr, -1, -1, -1, -1, false))
    res
var array<Lvl> LV = f_initLV()
// ──────────────────────── ДАННЫЕ СТАРШЕГО ТФ ────────────────────────
// Один tuple-запрос на ТФ вместо четырёх: меньше вызовов request.security и
// ровно одно вычисление EMA/ATR в каждом контексте.
[htfEma, htfEmaPast, htfAtr, htfClose] = request.security(syminfo.tickerid, htfTf, [ta.ema(close, htfEmaLen)[1], ta.ema(close, htfEmaLen)[slopeLen + 1], ta.atr(14)[1], close[1]], lookahead = barmerge.lookahead_on)
// EMA200 и ATR на ТФ касания (по умолчанию 1H)
[emaTouch, atrTouch] = request.security(syminfo.tickerid, touchTf, [ta.ema(close, htfEmaLen)[1], ta.atr(14)[1]], lookahead = barmerge.lookahead_on)
// дневной контекст, дневной ATR и экстремумы прошлого дня одним запросом
[atrD, dEma, autoDHi, autoDLo] = request.security(syminfo.tickerid, "D", [ta.atr(14)[1], ta.ema(close, htfEmaLen)[1], high[1], low[1]], lookahead = barmerge.lookahead_on)
// ──────────────────────── ДАННЫЕ РАБОЧЕГО ТФ (авто) ────────────────────────
string ltfTf  = ltfTfRaw == "" ? timeframe.period : ltfTfRaw
float  tfSec  = timeframe.in_seconds()
int    touchBars = int(math.max(1.0, math.round(memHours * 3600.0 / tfSec)))
bool   tfWarn = htfTf != "" and timeframe.in_seconds(htfTf) <= timeframe.in_seconds(timeframe.period)
bool   touchWarn = touchTf != "" and timeframe.in_seconds(touchTf) < timeframe.in_seconds(timeframe.period)
float emaLtfSec = request.security(syminfo.tickerid, ltfTf, ta.ema(close, ltfEmaLen)[1], lookahead = barmerge.lookahead_on)
float emaLtfNat = ta.ema(close, ltfEmaLen)
bool   ltfIsChart = timeframe.in_seconds(ltfTf) == timeframe.in_seconds()
float  emaLtf    = ltfIsChart ? emaLtfNat : emaLtfSec
float atrChart  = ta.atr(14)
// ATR-фолбэк: на первых барах ta.atr(14) = na, и все допуски превращались в
// «точное равенство цены». Считаем страховку от разрыва, а не от нуля.
float atrSafe   = na(atrChart) ? nz(ta.tr(true), syminfo.mintick * 10) : atrChart
float ema50v    = ta.ema(close, 50)
// Дашборд: сторона EMA200, наклон и расстояние в ATR по четырём ТФ.
[f1e, f1p, f1c, f1a] = request.security(syminfo.tickerid, mtfTf1, [ta.ema(close, htfEmaLen)[1], ta.ema(close, htfEmaLen)[slopeLen + 1], close[1], ta.atr(14)[1]], lookahead = barmerge.lookahead_on)
[f2e, f2p, f2c, f2a] = request.security(syminfo.tickerid, mtfTf2, [ta.ema(close, htfEmaLen)[1], ta.ema(close, htfEmaLen)[slopeLen + 1], close[1], ta.atr(14)[1]], lookahead = barmerge.lookahead_on)
[f3e, f3p, f3c, f3a] = request.security(syminfo.tickerid, mtfTf3, [ta.ema(close, htfEmaLen)[1], ta.ema(close, htfEmaLen)[slopeLen + 1], close[1], ta.atr(14)[1]], lookahead = barmerge.lookahead_on)
[f4e, f4p, f4c, f4a] = request.security(syminfo.tickerid, mtfTf4, [ta.ema(close, htfEmaLen)[1], ta.ema(close, htfEmaLen)[slopeLen + 1], close[1], ta.atr(14)[1]], lookahead = barmerge.lookahead_on)
// ТФ-фолбэк: если запрошенный старший ТФ не выше графика, считаем EMA на графике.
// Идея из JustExecution/HTF_indicator: используем только подтверждённые значения.
float emaCtxNative     = ta.ema(close, htfEmaLen)
float emaCtxNativePrev = emaCtxNative[1]
float emaCtxNativePast = ta.ema(close, htfEmaLen)[slopeLen + 1]
float htfEmaEff        = (tfWarn and tfFallback) ? emaCtxNativePrev : htfEma
float htfEmaPastEff    = (tfWarn and tfFallback) ? emaCtxNativePast : htfEmaPast
float htfAtrEff        = (tfWarn and tfFallback) ? atrChart : htfAtr
float htfCloseEff      = (tfWarn and tfFallback) ? close[1] : htfClose
float emaTouchEff      = (touchWarn and tfFallback) ? emaLtf : emaTouch
float atrTouchEff      = (touchWarn and tfFallback) ? atrChart : atrTouch
// ──────────────────────── 2. КОНТЕКСТ + 4. НАКЛОН ────────────────────────
float slopeAtrTotal = (na(htfEmaEff) or na(htfEmaPastEff) or na(htfAtrEff) or htfAtrEff == 0.0) ? na : (htfEmaEff - htfEmaPastEff) / htfAtrEff
float slopeVal = nz(slopeAtrTotal / slopeLen, 0.0)   // ATR на бар
// Нет данных старшего ТФ — это не «лонг по умолчанию», а полный запрет входа:
// сторона появляется только когда контекст реально известен.
bool ctxKnown  = not na(htfEmaEff) and not na(htfCloseEff)
bool ctxL      = ctxKnown and htfCloseEff >= htfEmaEff
bool ctxS      = ctxKnown and htfCloseEff < htfEmaEff
bool sideKnown = ctxL or ctxS
bool slopeL  = slopeVal >= minSlope
bool slopeS  = slopeVal <= -minSlope
bool flatMkt = math.abs(slopeVal) < minSlope
// ──────────────────────── 3. КАСАНИЕ 200 СТАРШЕГО ТФ ────────────────────────
float zoneHalf = nz(atrTouchEff, atrSafe) * tolHtf
bool  touchL   = not na(emaTouchEff) and low <= emaTouchEff + zoneHalf and close >= emaTouchEff - zoneHalf
bool  touchS   = not na(emaTouchEff) and high >= emaTouchEff - zoneHalf and close <= emaTouchEff + zoneHalf
int   barsTouchL = nz(ta.barssince(touchL), 999999)
int   barsTouchS = nz(ta.barssince(touchS), 999999)
bool  touchLRecent = barsTouchL <= touchBars
bool  touchSRecent = barsTouchS <= touchBars
// ──────────────────────── 9. НЕТ БОЛТАНКИ: ER + диапазон в ATR ────────────────────────
float erNum = math.abs(close - close[chopLen])
float erDen = math.sum(math.abs(close - close[1]), chopLen)
float erVal = erDen > 0.0 ? erNum / erDen : 0.0
bool  noChop = erVal >= erMin
// ──────────────────────── 5. ТЕСТ EMA200: та же линия, что и касание ────────────────────────
float testZone = nz(atrTouchEff, atrSafe) * tolLtf
// Касание EMA тоже считаем визитом: пока бар перекрывает полосу ±testZone,
// это то же самое касание. Иначе сетап перевзводился бы на каждом баре.
bool emaBand = not na(emaTouchEff) and low <= emaTouchEff + testZone and high >= emaTouchEff - testZone
var bool emaInBand  = false
var int  emaVisitBar = na
if emaBand
    if not emaInBand
        emaInBand := true
        emaVisitBar := bar_index
else
    emaInBand := false
bool  emaTestL = not na(emaTouchEff) and low <= emaTouchEff + testZone and close > emaTouchEff
bool  emaTestS = not na(emaTouchEff) and high >= emaTouchEff - testZone and close < emaTouchEff
int   barsEmaTestL = nz(ta.barssince(emaTestL), 999999)
int   barsEmaTestS = nz(ta.barssince(emaTestS), 999999)
bool  emaTestRecentL = barsEmaTestL <= testLook
bool  emaTestRecentS = barsEmaTestS <= testLook
// ──────────────────────── УРОВНИ: РЕЕСТР + СОСТОЯНИЕ ────────────────────────
// Один реестр для ручных уровней, PDH/PDL, PWH/PWL, ONH/ONL, IBH/IBL.
// Идеи из аналогов: RTH Levels (freeze-at-close для PD/ON/IB) и Prior Levels
// (единый список уровней вместо десятков отдельных серий). При смене цены
// уровня касания и отбои сбрасываются — иначе вчерашний PDH засчитывался бы
// как сегодняшний.
bool emaSrcOn = lvMode != "Только уровни"
bool lvSrcOn  = lvMode != "Только EMA200"
// авто-уровни прошлой недели (прошлый день пришёл выше в общем D-запросе)
[autoWHi, autoWLo] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
// Initial Balance (первый час 9:30–10:30 NY) и overnight-диапазон (18:00–09:30 NY)
bool inON = not na(time(timeframe.period, "1800-0930", "America/New_York"))
bool inIB = not na(time(timeframe.period, "0930-1030", "America/New_York"))
var float onH = na
var float onL = na
var float ibH = na
var float ibL = na
if inON and not inON[1]
    onH := high
    onL := low
else if inON
    onH := math.max(nz(onH, high), high)
    onL := math.min(nz(onL, low), low)
if inIB and not inIB[1]
    ibH := high
    ibL := low
else if inIB
    ibH := math.max(nz(ibH, high), high)
    ibL := math.min(nz(ibL, low), low)
float lvTolAbs = nz(atrChart, atrSafe) * lvTol
f_lvName(string nm, float px) =>
    nm == "" ? str.tostring(px, format.mintick) : nm
// Обновление уровня: при смене цены (новый день/неделя/сессия) сбрасываем
// только касания этого уровня. Идентичность уровня — его цена.
f_updLvl(array<Lvl> arr, int idx, string nm, float px, bool act, int kind, int prio) =>
    Lvl l = array.get(arr, idx)
    if act and (not l.act or na(l.px) or px != l.px)
        l.touchS  := -1
        l.rejectS := -1
        l.touchL  := -1
        l.rejectL := -1
        l.inBand  := false
    l.nm   := nm
    l.px   := px
    l.act  := act
    l.kind := kind
    l.prio := prio
    true
// цены и активность
f_updLvl(LV, 0, f_lvName(lv1n, lv1), lv1, lv1 > 0.0 and lvSrcOn, 0, 10)
f_updLvl(LV, 1, f_lvName(lv2n, lv2), lv2, lv2 > 0.0 and lvSrcOn, 0, 10)
f_updLvl(LV, 2, f_lvName(lv3n, lv3), lv3, lv3 > 0.0 and lvSrcOn, 0, 10)
f_updLvl(LV, 3, f_lvName(lv4n, lv4), lv4, lv4 > 0.0 and lvSrcOn, 0, 10)
f_updLvl(LV, 4, f_lvName(lv5n, lv5), lv5, lv5 > 0.0 and lvSrcOn, 0, 10)
f_updLvl(LV, 5, "PDH", autoDHi, useAuto and lvSrcOn and not na(autoDHi), 1, 5)
f_updLvl(LV, 6, "PDL", autoDLo, useAuto and lvSrcOn and not na(autoDLo), -1, 5)
f_updLvl(LV, 7, "PWH", autoWHi, useAuto and lvSrcOn and not na(autoWHi), 1, 5)
f_updLvl(LV, 8, "PWL", autoWLo, useAuto and lvSrcOn and not na(autoWLo), -1, 5)
f_updLvl(LV, 9, "ONH", onH, useIB and lvSrcOn and not na(onH) and not inON, 1, 3)
f_updLvl(LV, 10, "ONL", onL, useIB and lvSrcOn and not na(onL) and not inON, -1, 3)
f_updLvl(LV, 11, "IBH", ibH, useIB and lvSrcOn and not na(ibH) and not inIB, 1, 3)
f_updLvl(LV, 12, "IBL", ibL, useIB and lvSrcOn and not na(ibL) and not inIB, -1, 3)
// касания и отбои: пишем один раз при событии, бар запоминаем в реестре
// (на незакрытом баре не пишем, чтобы состояние не мигало внутри бара)
// Визит к уровню: касание фиксируется один раз за подход, а не на каждом баре,
// пока цена висит рядом. Иначе уровень, тестированный сутки назад, вечно
// показывал бы «касание 0 баров назад» и сетап не истекал бы никогда.
bool regOk = not onlyClosed or barstate.isconfirmed
for i = 0 to array.size(LV) - 1
    Lvl l = array.get(LV, i)
    if not l.act
        l.inBand := false
    else if regOk and not na(l.px)
        bool band = high >= l.px - lvTolAbs and low <= l.px + lvTolAbs
        if not band
            l.inBand := false
        else
            if not l.inBand
                l.inBand := true

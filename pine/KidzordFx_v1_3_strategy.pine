useOb     = input.bool(true, "Фактор: свежий Order Block", group = gSMC)
obImpulse = input.float(1.0, "OB: импульс свечи, ATR", minval = 0.3, step = 0.1, group = gOb)
obSearch  = input.int(5, "OB: противоположная свеча не старше N баров", minval = 1, maxval = 30, group = gOb)

sessIn    = input.session("1630-2300", "Торговое окно (НЙ, GMT+3)", group = gTrade)
tzIn      = input.string("GMT+3", "Часовой пояс окна", options = ["GMT+2", "GMT+3", "GMT+4", "UTC", "America/New_York", "Exchange"], group = gTrade)
showStats  = input.bool(true, "Таблица статистики", group = gTrade)
tp1R       = input.float(1.0, "TP1, R", minval = 0.1, step = 0.1, group = gTrade)

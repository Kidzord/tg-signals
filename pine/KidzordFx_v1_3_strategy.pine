//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  KIDZORDFX V1.3 · P2  ·  SMC / EMA200 CHECKLIST + TRADES
//  Чек-лист (как в таблице закрытого бота) + карточки сделок:
//  предварительная (до триггера), реальная (вход, SL, TP1-TP3), частичные закрытия,
//  перевод в БУ, статистика; канал/веер по подтверждённым пивотам.
//
//  ТФ: рабочий = ТФ графика (авто), касание EMA200 = 1H, контекст = 4H.
//  Логика оригинала неизвестна — это самостоятельная реализация тех же идей.
//
//  V1.3: вход требует весь чек-лист (в V1.2 четыре пункта игнорировались);
//  касание уровня считается один раз за подход; сетап взводится заново только
//  новым касанием; цель из строки 8 связана с TP; добавлены Order Blocks,
//  CHoCH, EQH/EQL, premium/discount, killzone, MTF-дашборд, трейлинг и
//  издержки в симуляции.
// ═══════════════════════════════════════════════════════════════════════════
strategy("KidzordFx V1.3 STRAT", "KidzordFxS", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500, default_qty_type = strategy.percent_of_equity, default_qty_value = 100, initial_capital = 10000, commission_type = strategy.commission.percent, commission_value = 0.0, slippage = 1, calc_on_every_tick = false, process_orders_on_close = true)
// ─────────────────────────────── ВХОДНЫЕ ───────────────────────────────
gTF    = "Таймфреймы"
gCtx   = "Старший ТФ: EMA200 / наклон / зона"
gTrg   = "Рабочий ТФ: тест и триггер"
gRisk  = "Риск и цель"
gLv    = "Уровни: PUT WALL / resistance"
gSMC   = "SMC-факторы (нужно N из 3)"
gFltr  = "Доп. фильтры: VWAP / EMA-стек / MACD / RSI"
gTrade = "Сделки: карточки, TP, статистика"
gTbl   = "Таблица и вид"
gMode  = "Режим проверки"
gExt   = "Расширение от EMA200"
gOb    = "Order Blocks"
gKz    = "Killzone (Нью-Йорк)"
gVal   = "Симуляция и издержки"
gDash  = "Дашборд старших ТФ"
htfTf     = input.timeframe("240", "ТФ контекста (4H)", group = gTF)
touchTf   = input.timeframe("60", "ТФ касания EMA200", group = gTF)
htfEmaLen = input.int(200, "EMA старшего ТФ: длина", minval = 10, maxval = 1000, group = gTF)
ltfTfRaw  = input.timeframe("", "Рабочий ТФ (пусто = ТФ графика)", group = gTF)
ltfEmaLen = input.int(200, "EMA рабочего ТФ: длина", minval = 10, maxval = 1000, group = gTF)
sideAllow = input.string("Обе", "Разрешённая сторона", options = ["Обе", "Только лонг", "Только шорт"], group = gTF)
tfFallback = input.bool(false, "ТФ-фолбэк на ТФ графика", group = gTF, tooltip = "Если ТФ контекста/касания ниже ТФ графика, считать EMA200 на ТФ графика вместо молчаливой блокировки сигналов.")
slopeLen  = input.int(20, "Окно наклона, баров", minval = 1, maxval = 200, group = gCtx)
minSlope  = input.float(0.01, "Мин. наклон EMA200, ATR/бар", minval = 0.0, step = 0.005, group = gCtx)
useDayCtx = input.bool(true, "Дневной контекст (цена vs EMA200 на D)", group = gCtx)
tolHtf    = input.float(0.6, "Допуск касания, в ATR (больше = «почти дотронулся»)", minval = 0.01, step = 0.05, group = gCtx)
memHours  = input.int(24, "Память касания, часов", minval = 1, maxval = 720, group = gCtx)
chopLen   = input.int(100, "Окно «болтанки», баров", minval = 10, group = gCtx)
erMin     = input.float(0.20, "Мин. эффективность (ER 0–1)", minval = 0.0, maxval = 1.0, step = 0.05, group = gCtx)
tolLtf    = input.float(0.15, "Зона теста EMA200, в ATR", minval = 0.01, step = 0.05, group = gTrg)
testLook  = input.int(20, "Тест актуален, баров", minval = 1, group = gTrg)
trigLook  = input.int(5, "Триггер актуален, баров", minval = 1, group = gTrg)
pinMult   = input.float(1.5, "Пин-бар: тень / тело", minval = 0.5, step = 0.1, group = gTrg)
usePin    = input.bool(true, "Триггер: пин-бар", group = gTrg)
useEngulf = input.bool(true, "Триггер: поглощение", group = gTrg)
useMicro  = input.bool(true, "Триггер: BOS (пробой свинга телом)", group = gTrg)
trigBosLen = input.int(5, "BOS: длина свинга, баров", minval = 2, maxval = 50, group = gTrg)
useIfvg   = input.bool(true, "Триггер: IFVG (инверсия имбаланса)", group = gTrg)
ifvgLook  = input.int(60, "IFVG актуален, баров", minval = 1, group = gTrg)
ifvgTol   = input.float(0.10, "IFVG: допуск теста, ATR", minval = 0.01, step = 0.05, group = gTrg)
minRangeK = input.float(0.40, "Мин. размер свечи-триггера, в ATR", minval = 0.0, step = 0.05, group = gTrg)
useExt    = input.bool(true, "Не входить далеко от EMA200", group = gExt, tooltip = "Гейт к строке 2. Касание могло быть сутки назад, а цена за это время ушла на 5 ATR — это уже не откат, а погоня.")
extMaxAtr = input.float(3.0, "Макс. расстояние цена↔EMA200, ATR", minval = 0.5, step = 0.25, group = gExt)
swingLen  = input.int(10, "Стоп: за N баров", minval = 2, group = gRisk)
stopBuf   = input.float(0.20, "Отступ стопа от свинга, ATR", minval = 0.0, step = 0.05, group = gRisk)
stopMode  = input.string("За манипуляцией", "База стопа", options = ["За манипуляцией", "Свинг"], group = gRisk)
manipLook = input.int(20, "Стоп: манипуляция актуальна, баров", minval = 1, group = gRisk)
riskAtrMode = input.bool(true, "Риск в коридоре считать в ATR", group = gRisk)
riskMinAtr = input.float(0.0, "Риск мин, ATR (0 = без нижней границы)", minval = 0.0, step = 0.05, group = gRisk)
riskMaxAtr = input.float(4.0, "Риск макс, ATR", minval = 0.1, step = 0.1, group = gRisk)
riskMin   = input.float(0.05, "Риск мин, %", minval = 0.01, step = 0.05, group = gRisk)

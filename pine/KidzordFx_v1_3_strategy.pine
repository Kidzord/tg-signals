p1Pct      = input.int(40, "Закрыть на TP1, % позиции", minval = 0, maxval = 100, group = gTrade)
p2Pct      = input.int(30, "Закрыть на TP2, % позиции", minval = 0, maxval = 100, group = gTrade)

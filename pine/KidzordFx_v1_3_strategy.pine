lv5n      = input.string("", "   подпись 5", group = gLv)
lvTol     = input.float(0.15, "Допуск теста уровня, ATR", minval = 0.01, step = 0.05, group = gLv)
lvLook    = input.int(60, "Тест уровня актуален, баров", minval = 1, group = gLv)
lvDays    = input.int(7, "Длина линий уровней, дней (0 = вся история)", minval = 0, maxval = 1000, group = gLv)
showLv    = input.bool(true, "Рисовать уровни", group = gLv)
useAuto   = input.bool(true, "Авто-уровни: хай/лоу дня и недели", group = gLv)
useIB     = input.bool(false, "Уровни IB (первый час) и overnight", group = gLv, tooltip = "IB 09:30–10:30 и overnight 18:00–09:30 по Нью-Йорку — концепция американских акций и фьючерсов. Для золота, FX и крипты держи выключенным.")
sweepLen  = input.int(20, "Свип: экстремум за N баров", minval = 3, group = gSMC)
useFracSweep = input.bool(true, "Свип по фракталу (точнее)", group = gSMC)

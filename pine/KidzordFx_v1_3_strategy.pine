onlyClosed = input.bool(true, "Сигнал только по закрытию бара", group = gMode, tooltip = "Вкл: метка, вход и алерт появляются только после закрытия бара — сигнал не мигает внутри бара. Выкл: сигнал виден сразу, но может исчезнуть до закрытия.")

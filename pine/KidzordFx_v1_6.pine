//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  KIDZORDFX V1.3 · P1  ·  SMC / EMA200 CHECKLIST + TRADES
//  Чек-лист (как в таблице закрытого бота) + карточки сделок:
//  предварительная (до триггера), реальная (вход, SL, TP1-TP3), частичные закрытия,
//  перевод в БУ, статистика; канал/веер по подтверждённым пивотам.
//
//  V1.3: торговые сессии (Азия / Лондон / Нью-Йорк / перекрытие Лдн+НЙ) по местному
//  биржевому времени — перевод на летнее/зимнее время учитывается автоматически
//  (IANA-зоны Asia/Tokyo, Europe/London, America/New_York). Прежнее «одно окно»
//  с фиксированным GMT-смещением доступно отдельным режимом.
//
//  V1.4: зоны сессий — боксы по крайним точкам свечей (верх = максимум сессии,
//  низ = минимум) с подписями; рисуются от открытия до закрытия сессии вместо
//  заливки фоном на весь экран.
//
//  V1.5: проверено под Минск (GMT+3, без перевода часов): чек-лист и подписи
//  зон показывают живые окна по МСК; у кильзон есть режим «Минск».
//
//  Профиль по умолчанию — сбалансированный: сессии Лдн+НЙ, CHoCH 2/4, спред-фильтр
//  вкл, триггер любой, трейлинг UT Bot после TP1, лимиты дня 3 сделки / −2R,
//  объём от риска. Жёсткая дисциплина (кильзоны, 3/4 фактора, пул, rVol, сила 2)
//  включается галочками, если сигналов становится слишком много.
//
//  V1.6: Order Blocks (отрисовка + опциональный фильтр «вход у свежего OB»),
//  порог размера FVG; фильтр «мелких» BOS покрыт дизайном рефа (фрактал ∪ экстремум).
//
//  Карта кода (P4-1): ВХОДЫ → РЕЕСТР УРОВНЕЙ LV → ДАННЫЕ СТАРШИХ ТФ → УРОВНИ,
//  СВИП И ТРИГГЕРЫ → ЦЕЛЬ → ФАКТОРЫ SMC (CHoCH, ORDER BLOCKS) → VWAP И rVOL →
//  СТОРОНА, СЕССИИ, КИЛЬЗОНЫ → ЗОНЫ СЕССИЙ И ASIA H/L → r-ГЕЙТЫ → СДЕЛКИ И
//  СОПРОВОЖДЕНИЕ → ПРЕВЬЮ-ПЛАН → ТАБЛИЦЫ И ДИАГНОСТИКА → АЛЕРТЫ.
//  Полный журнал изменений — в файле плана (KidzordFx_V1_3_план_улучшений.md).
//  Проверка чистой логики — отдельным скриптом KidzordFx_selftest.pine (P4-2).
//
//  ТФ: рабочий = ТФ графика (авто), касание EMA200 = 1H, контекст = 4H.
//  Логика оригинала неизвестна — это самостоятельная реализация тех же идей.
// ═══════════════════════════════════════════════════════════════════════════
indicator("KidzordFx V1.6", "KidzordFx", overlay = true, max_bars_back = 500, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)
// ─────────────────────────────── ВХОДНЫЕ ───────────────────────────────
gTF    = "Таймфреймы"
gCtx   = "Старший ТФ: EMA200 / наклон / зона"
gTrg   = "Рабочий ТФ: тест и триггер"
gRisk  = "Риск и цель"
gLv    = "Уровни: PUT WALL / resistance"
gSMC   = "SMC-факторы (нужно N из 3)"
gFltr  = "Доп. фильтры: VWAP / EMA-стек / MACD / RSI"
gTrade = "Сделки: карточки, TP, статистика"
gTbl   = "Таблица и вид"
gMode  = "Режим проверки"
htfTf     = input.timeframe("240", "ТФ контекста (4H)", group = gTF)
touchTf   = input.timeframe("60", "ТФ касания EMA200", group = gTF)
htfEmaLen = input.int(200, "EMA старшего ТФ: длина", minval = 10, maxval = 1000, group = gTF)
ltfTfRaw  = input.timeframe("", "Рабочий ТФ (пусто = ТФ графика)", group = gTF)
ltfEmaLen = input.int(200, "EMA рабочего ТФ: длина", minval = 10, maxval = 1000, group = gTF)
sideAllow = input.string("Обе", "Разрешённая сторона", options = ["Обе", "Только лонг", "Только шорт"], group = gTF)
tfFallback = input.bool(false, "ТФ-фолбэк на ТФ графика", group = gTF, tooltip = "Если ТФ контекста/касания ниже ТФ графика, считать EMA200 на ТФ графика вместо молчаливой блокировки сигналов.")
slopeLen  = input.int(20, "Окно наклона, баров", minval = 1, maxval = 200, group = gCtx)
minSlope  = input.float(0.01, "Мин. наклон EMA200, ATR/бар", minval = 0.0, step = 0.005, group = gCtx)
useDayCtx = input.bool(true, "Дневной контекст (цена vs EMA200 на D)", group = gCtx)
tolHtf    = input.float(0.6, "Допуск касания, в ATR (больше = «почти дотронулся»)", minval = 0.01, step = 0.05, group = gCtx)
memHours  = input.int(24, "Память касания, часов", minval = 1, maxval = 720, group = gCtx)
chopLen   = input.int(100, "Окно «болтанки», баров", minval = 10, group = gCtx)
erMin     = input.float(0.20, "Мин. эффективность (ER 0–1)", minval = 0.0, maxval = 1.0, step = 0.05, group = gCtx)
tolLtf    = input.float(0.15, "Зона теста EMA200, в ATR", minval = 0.01, step = 0.05, group = gTrg)
testLook  = input.int(20, "Тест актуален, баров", minval = 1, group = gTrg)
trigLook  = input.int(5, "Триггер актуален, баров", minval = 1, group = gTrg)
pinMult   = input.float(1.5, "Пин-бар: тень / тело", minval = 0.5, step = 0.1, group = gTrg)
usePin    = input.bool(true, "Триггер: пин-бар", group = gTrg)
useEngulf = input.bool(true, "Триггер: поглощение", group = gTrg)
useMicro  = input.bool(true, "Триггер: BOS (пробой свинга телом)", group = gTrg)
trigBosLen = input.int(5, "BOS: длина свинга, баров", minval = 2, maxval = 50, group = gTrg)
useIfvg   = input.bool(true, "Триггер: IFVG (инверсия имбаланса)", group = gTrg)
ifvgLook  = input.int(60, "IFVG актуален, баров", minval = 1, group = gTrg)
ifvgTol   = input.float(0.10, "IFVG: допуск теста, ATR", minval = 0.01, step = 0.05, group = gTrg)
minTrigPow = input.int(1, "Мин. сила триггера (0 = любой)", minval = 0, maxval = 4, group = gTrg, tooltip = "Пин-бар = 1, поглощение = 2, IFVG = 3, BOS = 4. По умолчанию 1 — работает любой включённый триггер; 2 отсекает голые пины.")
minRangeK = input.float(0.40, "Мин. размер свечи-триггера, в ATR", minval = 0.0, step = 0.05, group = gTrg)
swingLen  = input.int(10, "Стоп: за N баров", minval = 2, group = gRisk)
stopBuf   = input.float(0.20, "Отступ стопа от свинга, ATR", minval = 0.0, step = 0.05, group = gRisk)
stopMode  = input.string("За манипуляцией", "База стопа", options = ["За манипуляцией", "Свинг"], group = gRisk)
manipLook = input.int(20, "Стоп: манипуляция актуальна, баров", minval = 1, group = gRisk)
riskAtrMode = input.bool(true, "Риск в коридоре считать в ATR", group = gRisk)
riskMinAtr = input.float(0.0, "Риск мин, ATR (0 = без нижней границы)", minval = 0.0, step = 0.05, group = gRisk)
riskMaxAtr = input.float(4.0, "Риск макс, ATR", minval = 0.1, step = 0.1, group = gRisk)
riskMin   = input.float(0.05, "Риск мин, %", minval = 0.01, step = 0.05, group = gRisk)
riskMax   = input.float(1.50, "Риск макс, %", minval = 0.02, step = 0.05, group = gRisk)
liqLen    = input.int(60, "Ликвидность: экстремум за N баров", minval = 5, group = gRisk)
tgtMin    = input.float(0.15, "Цель мин, %", minval = 0.0, step = 0.05, group = gRisk)
tgtMax    = input.float(5.00, "Цель макс, %", minval = 0.0, step = 0.05, group = gRisk)
minRR     = input.float(1.5, "Мин. R:R", minval = 0.1, step = 0.1, group = gRisk)
useDayBud = input.bool(true, "Цель не дальше дневного хода", group = gRisk)
dayBudgetK = input.float(1.0, "Дневной ход = ATR(D) ×", minval = 0.2, step = 0.1, group = gRisk)
maxDayTrades = input.int(3, "Макс. сделок за день (0 = без лимита)", minval = 0, maxval = 50, group = gRisk)
dayStopR     = input.float(2.0, "Стоп дня, R (0 = без лимита)", minval = 0.0, step = 0.5, group = gRisk, tooltip = "После просадки за день до −N R новые входы блокируются до следующего дня.")
useTrail    = input.bool(true, "Трейлинг-стоп после TP (UT Bot)", group = gRisk, tooltip = "Схема UT Bot: стоп подтягивается к close − k×ATR (лонг) / close + k×ATR (шорт) и никогда не отдаляется. Включается со следующего бара после указанного TP. При выходе по трейлу R считается по фактической цене стопа — и в плюс, и в минус.")
trailAfter  = input.int(1, "Включать трейлинг после TP №", minval = 1, maxval = 3, group = gRisk)
trailK      = input.float(2.0, "Трейлинг: отступ, ATR ×", minval = 0.1, step = 0.1, group = gRisk)
useLot      = input.bool(true, "Считать объём от риска", group = gRisk, tooltip = "Объём = депозит × риск% / дистанция до стопа. Для золота — в унциях, для крипты — в монетах (без учёта плеча и стоимости контракта: проверяйте шаг лота у брокера).")
depUsd      = input.float(10000, "Депозит, USDT", minval = 0, group = gRisk)
riskPct     = input.float(1.0, "Риск на сделку, %", minval = 0.01, step = 0.1, group = gRisk)
lvMode    = input.string("Уровни + EMA200", "Источник уровня", options = ["Только EMA200", "Только уровни", "Уровни + EMA200"], group = gLv)
lv1       = input.float(0.0, "Уровень 1 (0 = выкл.)", minval = 0.0, step = 0.1, group = gLv)
lv1n      = input.string("", "   подпись 1", group = gLv)
lv2       = input.float(0.0, "Уровень 2", minval = 0.0, step = 0.1, group = gLv)
lv2n      = input.string("", "   подпись 2", group = gLv)
lv3       = input.float(0.0, "Уровень 3", minval = 0.0, step = 0.1, group = gLv)
lv3n      = input.string("", "   подпись 3", group = gLv)
lv4       = input.float(0.0, "Уровень 4", minval = 0.0, step = 0.1, group = gLv)
lv4n      = input.string("", "   подпись 4", group = gLv)
lv5       = input.float(0.0, "Уровень 5", minval = 0.0, step = 0.1, group = gLv)
lv5n      = input.string("", "   подпись 5", group = gLv)
lvPersist = input.int(6, "Закрепление за уровнем, баров", minval = 1, maxval = 100, group = gLv)
lvTol     = input.float(0.15, "Допуск теста уровня, ATR", minval = 0.01, step = 0.05, group = gLv)
lvLook    = input.int(60, "Тест уровня актуален, баров", minval = 1, group = gLv)
lvDays    = input.int(7, "Длина линий уровней, дней (0 = вся история)", minval = 0, maxval = 1000, group = gLv)
showLv    = input.bool(true, "Рисовать уровни", group = gLv)
useAuto   = input.bool(true, "Авто-уровни: хай/лоу дня и недели", group = gLv)
useIB     = input.bool(false, "Уровни IB (первый час) и overnight", group = gLv, tooltip = "IB 09:30–10:30 и overnight 18:00–09:30 по Нью-Йорку — концепция американских акций и фьючерсов. Для золота, FX и крипты держи выключенным.")
sweepLen  = input.int(20, "Свип: экстремум за N баров", minval = 3, group = gSMC)
useFracSweep = input.bool(true, "Свип по фракталу (точнее)", group = gSMC)
fracL     = input.int(2, "Фрактал: баров слева", minval = 1, maxval = 20, group = gSMC)
fracR     = input.int(2, "Фрактал: баров справа", minval = 1, maxval = 20, group = gSMC)
bosLen    = input.int(20, "BOS: структура за N баров", minval = 3, group = gSMC)
fvgLook   = input.int(30, "FVG актуален, баров", minval = 1, group = gSMC)
rangeLen  = input.int(30, "Диапазон: окно, баров", minval = 5, group = gSMC)
rangeMinAtr = input.float(2.0, "Диапазон мин, ATR", minval = 0.0, step = 0.5, group = gSMC)
rangeMaxAtr = input.float(20.0, "Диапазон макс, ATR", minval = 1.0, step = 1.0, group = gSMC)
facLook   = input.int(30, "Фактор актуален, баров", minval = 1, group = gSMC)
needFac   = input.int(2, "Нужно факторов (из 3–4)", minval = 1, maxval = 4, group = gSMC)
useChoch  = input.bool(true, "Фактор: CHoCH (смена характера)", group = gSMC, tooltip = "O-1: слом структуры ПРОТИВ текущего тренда (по последовательности BOS) — первый сигнал разворота. Свежий CHoCH в сторону сделки засчитывается 4-м фактором. Выкл = работают прежние 3 фактора.")
showEq    = input.bool(true, "Показывать EQH/EQL (пулы ликвидности)", group = gSMC, tooltip = "O-3: равные хаи/лои — зоны стопов. Пунктирная линия тянется, пока пул не собран (свипнут); после сбора помечается ✓.")
eqTol     = input.float(0.25, "EQH/EQL: допуск равенства, ATR", minval = 0.01, step = 0.05, group = gSMC)
eqKeep    = input.int(6, "Сколько пулов хранить", minval = 1, maxval = 30, group = gSMC)
useEq     = input.bool(false, "Блокировать вход под/над живым пулом", group = gSMC, tooltip = "Лонг запрещён, пока над ценой в пределах радиуса висит несобранный EQH (риск стоп-ханта); шорт — под ценой живой EQL. После свипа пул считается собранным и не мешает.")
eqNear    = input.float(1.5, "Радиус блокировки, ATR", minval = 0.1, step = 0.1, group = gSMC)
obShow    = input.bool(true, "Показывать Order Blocks", group = gSMC, tooltip = "O-2: блок заказов — последняя свеча против импульса перед сломом структуры. Бычьи (под ценой) — зоны спроса, медвежьи (над ценой) — предложения. Смягчённый блок (закрытие за противоположной границей) удаляется.")
obLook    = input.int(10, "OB: поиск свечи-основы, баров", minval = 2, maxval = 50, group = gSMC)
obKeep    = input.int(6, "Сколько блоков держать", minval = 1, maxval = 20, group = gSMC)
useOb     = input.bool(false, "Вход только у свежего OB", group = gSMC, tooltip = "Лонг разрешён, если под ценой в пределах радиуса есть несмягчённый бычий OB; шорт — если над ценой медвежий. Выкл = не блокирует.")
obNear    = input.float(1.5, "Радиус OB, ATR", minval = 0.1, step = 0.1, group = gSMC)
obTgtOn   = input.bool(false, "Цели по противостоящим OB", group = gSMC, tooltip = "План №2 п.5: если впереди есть несмягчённый Order Block, его ближайший край становится целью — раньше фиксированных R-уровней и при том же фильтре процента и R:R. Выкл = цели только по уровням и свингам.")
fvgMinAtr = input.float(0.0, "FVG: мин размер, ATR (0 = любой)", minval = 0.0, step = 0.05, group = gSMC, tooltip = "O-6: гэп должен быть больше указанной доли ATR, иначе не считается имбалансом. Влияет на триггер IFVG и фактор FVG. 0 = прежнее поведение.")
useDisc   = input.bool(false, "Фильтр дисконт/премиум", group = gSMC, tooltip = "O-4: лонг только в нижней половине диапазона (дисконт), шорт — в верхней (премиум). Диапазон — dealing range от последних фрактальных свингов, без них — N-баровое окно. Выключен = не блокирует.")
useVwap  = input.bool(false, "VWAP сессии: лонг выше / шорт ниже", group = gFltr)
useStack = input.bool(false, "EMA 9/21/50 выстроены по тренду", group = gFltr)
useMacd  = input.bool(false, "MACD: гистограмма в сторону сделки", group = gFltr)
useRsi   = input.bool(false, "RSI: не перекуплен / не перепродан", group = gFltr)
emaF1    = input.int(9, "EMA фильтра 1", minval = 1, group = gFltr)
emaF2    = input.int(21, "EMA фильтра 2", minval = 1, group = gFltr)
emaF3    = input.int(50, "EMA фильтра 3", minval = 1, group = gFltr)
macdFast = input.int(12, "MACD fast", minval = 1, group = gFltr)
macdSlow = input.int(26, "MACD slow", minval = 1, group = gFltr)
macdSigL = input.int(9, "MACD signal", minval = 1, group = gFltr)
rsiLen   = input.int(14, "RSI длина", minval = 1, group = gFltr)
rsiOB    = input.int(70, "RSI перекупленность", minval = 50, maxval = 100, group = gFltr)
rsiOS    = input.int(30, "RSI перепроданность", minval = 0, maxval = 50, group = gFltr)
useSprd  = input.bool(true, "Спред: бар входа ≥ N × спред", group = gFltr)
sprTicks = input.float(5.0, "Спред, тиков", minval = 0.1, step = 0.5, group = gFltr, tooltip = "Оценка спреда инструмента в тиках: золото ≈ 3–5, мажоры ≈ 1–2.")
sprK     = input.int(5, "Бар входа ≥ N × спред", minval = 1, maxval = 50, group = gFltr)
useRvol   = input.bool(false, "rVol: фильтр объёма часа", group = gFltr, tooltip = "P1-4: объём бара против среднего объёма этого же часа за N дней (EWMA, нормировано на бар). Тихий час = мало участников = хуже входы. Если у символа нет объёма, фильтр сам отключается.")
rvolMin   = input.float(0.8, "rVol мин", minval = 0.1, step = 0.1, group = gFltr)
rvolDays  = input.int(5, "rVol: дней в среднем", minval = 1, maxval = 20, group = gFltr)
useDxy    = input.bool(false, "Межрыночный фильтр: доллар (DXY)", group = gFltr, tooltip = "Для золота доллар — главный драйвер: лонг разрешён, только когда DXY ниже своей EMA (доллар слабеет), шорт — когда выше. Для инструментов, не зависящих от доллара, держите выключенным.")
dxyTicker = input.string("TVC:DXY", "Тикер доллара", group = gFltr)
dxyEmaLen = input.int(20, "DXY: EMA, баров", minval = 5, maxval = 200, group = gFltr)
showTrades = input.bool(true, "Рисовать карточки сделок", group = gTrade)
keepCards  = input.int(3, "Сколько последних сделок показывать", minval = 1, maxval = 10, group = gTrade)
modeSoft   = input.bool(true, "Мягкий режим (часть условий — совещательно)", group = gMode)
softNeed   = input.int(2, "Мягкий: минимум из 3 (+фильтры)", minval = 0, maxval = 4, group = gMode, tooltip = "Совещательные пункты: наклон, диапазон, SMC-факторы и (если включены) доп. фильтры. Цель/RR обязательна всегда.")
onlyClosed = input.bool(true, "Сигнал только по закрытию бара", group = gMode, tooltip = "Вкл: метка, вход и алерт появляются только после закрытия бара — сигнал не мигает внутри бара. Выкл: сигнал виден сразу, но может исчезнуть до закрытия.")
showPreview = input.bool(true, "Предварительные сделки (до триггера)", group = gTrade)

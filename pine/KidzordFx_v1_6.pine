tzIn      = input.string("GMT+3", "Часовой пояс окна", options = ["GMT+2", "GMT+3", "GMT+4", "UTC", "Exchange", "Минск (GMT+3)"], group = gTrade, tooltip = "Только для режима «Одно окно (вручную)». «Минск (GMT+3)» = Europe/Minsk (без перевода часов). Фиксированные GMT-смещения часы не переводят — для автоматики используйте режим «Сессии».")

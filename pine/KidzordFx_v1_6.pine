tblCompact = input.bool(false, "Компактные таблицы (мобильный)", group = gTbl, tooltip = "P3-3: чек-лист без пояснений (только пункты и ✓/✗), статистика из 5 ключевых строк, диагностика скрыта — для телефона.")
showTL    = input.bool(true, "Наклонные линии по экстремумам", group = gTbl)
pivL      = input.int(5, "Пивот: баров слева", minval = 1, maxval = 100, group = gTbl)
pivR      = input.int(5, "Пивот: баров справа", minval = 1, maxval = 100, group = gTbl)
tlCount   = input.int(3, "Сколько линий на сторону", minval = 1, maxval = 20, group = gTbl)
tlExtend  = input.bool(true, "Продлевать вправо", group = gTbl)
showEma50 = input.bool(false, "Показывать EMA 50", group = gTbl)

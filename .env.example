# ---- Telegram (сигнальный бот) ----
# токен от @BotFather, бот должен быть админом группы
TG_BOT_TOKEN=
# ID группы: отрицательное число, для супергрупп начинается с -100
TG_CHAT_ID=

# ---- Telegram (premium-бот: подписчики задают свой депозит и риск) ----
# отдельный бот от @BotFather, запускается своим процессом subbot.bat
SUB_BOT_TOKEN=
# подпись канала на карточке-сводке
CHANNEL_HANDLE=@your_username
# ссылка на бесплатную группу для сообщения «подпишись» (инвайт-ссылка или https://t.me/username)
CHANNEL_INVITE=
# username premium-бота без @ — из него собирается реферальная ссылка ?start=ref_<id>
SUB_BOT_USERNAME=
# ссылка на поддержку (t.me/username или инвайт) — кнопка «Поддержка» в боте; пусто = кнопки нет
SUPPORT_URL=

# ---- Пробный доступ и рефералы ----
# пробный доступ: сколько дней даём один раз новому пользователю (0 — выключен)
TRIAL_ENABLED=1
TRIAL_DAYS=3
# реферальная программа: сколько дней получает пригласивший за оплату друга
REF_ENABLED=1
REF_DAYS=7
# сколько дней получает сам приглашённый после первой оплаты (двусторонняя)
REF_DAYS_FRIEND=3
# промокоды: CODE:DAYS через запятую. Один код — один раз на пользователя.
# пример: THREADS:3,X:3,TIKTOK:3
PROMO_CODES=THREADS:3,X:3,TIKTOK:3

# ---- Premium-подписка (Telegram Stars) ----
# цена подписки в Stars за 30 дней (1–10000). Вывод через Fragment, холд 21 день
SUB_PRICE_STARS=500
# годовой план: разовый счёт Stars на 365 дней (0 — выключен)
SUB_PRICE_STARS_YEAR=0
SUB_TITLE=KidzordFX Premium
# описание, которое видит пользователь на экране оплаты
SUB_DESCRIPTION=Быстрые сигналы по золоту, форексу и индексам в боте: вход, стоп и три цели приходят сразу, без задержки. Плюс карточка твоего счёта под твой депозит и риск.
# задержка публикации сигнала в бесплатную группу, секунд (0 — без задержки).
# premium-подписчики получают сигнал сразу через очередь signals_queue.jsonl
FREE_DELAY_SEC=600

# ---- Premium-подписка (крипта через Crypto Pay / @CryptoBot) ----
# токен приложения: @CryptoBot -> /myapps -> Create App -> API token
# пусто = оплата криптой выключена, работает только Stars
CRYPTO_PAY_TOKEN=
# 1 — тестовая сеть (testnet-pay.crypt.bot), 0 — боевая
CRYPTO_PAY_TESTNET=0
# цена подписки в крипте за 30 дней (в единицах CRYPTO_ASSET)
CRYPTO_PRICE_USDT=8
# годовая цена в крипте (0 — годовой план выключен)
CRYPTO_PRICE_USDT_YEAR=0
# актив, в котором выставляется счёт: USDT, USDC, TON, BTC и т.п.
CRYPTO_ASSET=USDT

# значения по умолчанию, пока подписчик не задал свои
PLAN_DEPOSIT=10000
PLAN_RISK_PCT=0.5
PLAN_DAILY_PCT=5
PLAN_TOTAL_PCT=10

# ---- Вебхук ----
# придумай длинную строку: URL будет https://<host>/tv/<эта строка>
WEBHOOK_SECRET=change-me-to-long-random-string
HOST=0.0.0.0
PORT=8080

# какие тикеры принимать (подстрока, регистр не важен). Пусто = принимать всё
# список = инструменты из multi.bat: золото, форекс, индексы
SYMBOL_FILTER=XAU,GOLD,AUDUSD,USDCAD,EURUSD,GBPUSD,US500,EUSTX50,UK100,DE40,JPN225

# ---- График ----
BARS_COUNT=120
# суффикс тикера у брокера, если он есть: XAUUSD.r -> .r
MT5_SUFFIX=
# 1 — при выходе просить PNG у ScreenshotEA; 0 — всегда рисовать карточку самим
MT5_SCREENSHOT=1
# резервный источник, если MT5 недоступен (колонки: time,open,high,low,close,volume)
DATA_CSV=
CARD_TITLE=KIDZORDFX

# ---- Дневной продающий пост ----
PROMO_ENABLED=1
PROMO_TIME=10:00
PROMO_TZ=Europe/Moscow
# \n — перенос строки, HTML-теги Telegram разрешены
PROMO_TEXT=📊 <b>KidzordFx V1</b> — индикатор для золота, форекса и индексов на MetaTrader 5\n\nСвип ликвидности + BOS + зона EMA200 старшего ТФ, чек-лист из 12 пунктов, готовые вход, стоп и три цели.\n\nСигналы по золоту, форексу и индексам публикуются здесь.\nДоступ к индикатору — @your_username

# ---- Бот без TradingView (сигналы считаются по барам MT5) ----
# символ и таймфрейм, по которым считается чек-лист
BOT_SYMBOL=XAUUSD
BOT_TF=15
# период опроса MT5, секунд
BOT_POLL_SEC=20
# сколько баров истории грузить (для окон 100–120 баров нужно с запасом)
BOT_BARS=1500
# 1 = ничего не отправлять, только печатать (для проверки)
BOT_DRY=0
# стратегия: sonar — реакция от уровня (по разобранному видео), classic — пробой BOS
STRATEGY=sonar
# sonar: сколько касаний делает уровень значимым (2 — больше сигналов, 3 — чище)
SONAR_TOUCHES=2
# sonar: цель в R от стопа
SONAR_TARGET_R=2.0
# classic: узкий стоп-коридор и R:R >= 2
CL_RISK_MAX_ATR=2.0
CL_MIN_RR=2.0
# classic: доли частичных фиксаций на TP1/TP2, %. 0/0 — держать всё до TP3
# со стопом в БУ после TP1 (WFA 2026-11-03: OOS +17.8R против +5.4R у 40/30)
CL_P1_PCT=40
CL_P2_PCT=30

# ---- Тизер, пометка «поздно», постмортем (bot.py) ----
# тизер «готовится вход» в группе, когда цена подошла к зоне ближе чем TEASER_NEAR_PCT, %
TEASER_ENABLED=1
TEASER_NEAR_PCT=0.15
# пометка «поздно» у отложенного поста в группе, если цена ушла от входа в нашу сторону больше LATE_MOVE_PCT
LATE_ENABLED=1
LATE_MOVE_PCT=0.2
# пропуск сигнала, если текущий спред больше N R от риска сделки (0 = выкл)
SPREAD_MAX_R=0.25
# разбор к итогу сделки: вход был по правилам или нет
POSTMORTEM_ENABLED=1

# ---- Автопосты (autoposts.py) ----
# личный чат владельца: сюда напоминания о постах для Threads.
# заполняется сам командой /threads в premium-боте (owner.json), тут — как запасной вариант
OWNER_CHAT_ID=
# ссылка на premium-бота — кнопка в продающем посте
PREMIUM_URL=https://t.me/KidzordPremim_bot
# расписание постов в группу, время в PROMO_TZ
PLAN_TIME=08:00
DAY_SUMMARY_TIME=23:30
WEEK_SUMMARY_TIME=23:50
# Telegram-контент: раз в день бот сам публикует следующий пост в группу
TG_CONTENT_ENABLED=1
TG_CONTENT_TIME=12:00
# напоминания о постах Threads в личку (ЧЧ:ММ через запятую), 1/0 — включить
THREADS_REMIND_ENABLED=1
THREADS_REMIND_TIMES=09:00,14:00
# отдельный слот: пост по последней закрытой сделке и недельный трек-рекорд
THREADS_RESULT_ENABLED=1
THREADS_RESULT_TIME=19:00
THREADS_WEEK_ENABLED=1
THREADS_WEEK_TIME=20:00
# напоминания о постах для X (отдельный англ. аккаунт, англ. карточки)
X_REMIND_ENABLED=1
X_REMIND_TIMES=10:30,16:30
# TikTok: карусель с карточками и текст в личку владельцу.
# Два слота: днём «что сделал в боте», вечером дневниковая история.
TIKTOK_REMIND_ENABLED=1
TIKTOK_REMIND_TIMES=12:30,19:30
# лендинг: пересборка landing/index.html из trades.jsonl
LANDING_ENABLED=1
LANDING_TIME=23:55

# ---- Прочее ----
# сколько секунд не публиковать повторный сигнал с теми же уровнями
DEDUP_TTL_SEC=900
DISCLAIMER=Не является инвестиционной рекомендацией.
# время на карточке: MT5 отдаёт серверное время брокера, поэтому и подпись «сервер»
DISPLAY_TZ=Europe/Moscow
TZ_LABEL=сервер

# ---- Логирование и мониторинг ----
# уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# 1 = JSON-логи (для парсинга в ELK/Grafana), 0 = обычный текст
LOG_JSON=0
# путь к файлу логов (пусто = только в консоль)
LOG_FILE=
# ежедневный heartbeat владельцу и дайджест в канал (ЧЧ:ММ, DISPLAY_TZ)
HEARTBEAT_TIME=09:00
DIGEST_TIME=21:00
# мониторинг пульса ботов: как часто проверять и через сколько минут тишины алерт
MONITOR_ENABLED=1
MONITOR_EVERY_MIN=15
MONITOR_STALE_MIN=15
# сколько процессов bot.py должно работать (range AUDUSD+USDCAD+EURUSD + classic XAUUSD)
HEARTBEAT_EXPECT_BOTS=4
# внешний dead-man switch: URL healthchecks.io (пусто = выключен).
# Если упал весь ПК, локальный монитор не поможет — пинговать должен внешний сервис.
HEALTHCHECK_URL=
# доставка подписчикам: попыток на сообщение и алерты владельцу о недоставке
DELIVERY_MAX_ATTEMPTS=6
DELIVERY_ALERT=1
# SQLite-файл outbox и журнала платежей (пусто = state.db рядом с проектом)
STATE_DB=

# ---- Надёжность: kill-switch, форвард-контроль, restore-drill, новости ----
# портфельный лимит убытка за неделю в R (отрицательный); 0 = выключить
PORTFOLIO_WEEK_LIMIT_R=-6
# сколько сделок минимум нужно, чтобы недельный лимит сработал
PORTFOLIO_WEEK_MIN_TRADES=4
# форвард-контроль: окно последних сделок на символ и порог деградации в R
FORWARD_WINDOW=20
FORWARD_DEGRADE_R=-3
FORWARD_CONTROL_ENABLED=1
FORWARD_CONTROL_TIME=18:00
# тренировочное восстановление последнего бэкапа в песочницу (воскресенье)
RESTORE_DRILL_ENABLED=1
RESTORE_DRILL_TIME=18:10
# компонент отсутствует дольше N минут — алерт владельцу
COMPONENT_ALERT_MIN=10
# новостной фильтр ForexFactory: окно до и после красных событий, минут
NEWS_FILTER_ENABLED=1
NEWS_BLOCK_BEFORE_MIN=30
NEWS_BLOCK_AFTER_MIN=15
NEWS_CACHE_TTL_H=6

# ---- Админ-панель ----
# токен для доступа к админ-панели (заголовок X-Admin-Token)
ADMIN_TOKEN=change-me-admin-token
# ---- Threads (необязательно) ----
# id профиля Threads и long-lived токен из приложения Meta
THREADS_USER_ID=
THREADS_TOKEN=
# публичный адрес, по которому доступны карточки (для постов с картинкой);
# без него в Threads уходит только текст
THREADS_IMAGE_BASE=

# ---- Стратегия range (bot.py) ----
# параметры проверены walk-forward 2026-11-02: range включён на AUDUSD/USDCAD
RANGE_ZONE_TF=240
RANGE_STOP_ATR=1.0
RANGE_STOP_PTS=10.0
RANGE_TP_R=3.0
RANGE_MAX_STOPS=0
RANGE_FLIP_KEEP=60
RANGE_ER_MAX=0.20
# сторона сделок: both / short / long. WFA 2026-11-03 фильтр «только шорт»
# не подтвердил (AUDUSD +1.15R против +19.25R у both); эксперименты — вручную.
RANGE_SIDE=both
# тренд-фильтр по H4 EMA200: off / with / against. WFA 2026-11-03: EURUSD with
# даёт +41.9R OOS (63% активных фолдов); для AUDUSD 58% — кандидат.
RANGE_TREND=off
# окно торговли по времени сервера, "0800-2300"; пусто = выключено
RANGE_SESSION=
# сколько стопов на счёте за сутки закрывают день (0 = выключено)
MAX_DAILY_STOPS=3

# ---- Candle Range Theory (crt.py) ----
# старший ТФ диапазона C1; рабочий ТФ — BOT_TF (H4-диапазон / M15-вход)
CRT_RANGE_TF=240
# classic — свип C2 с возвратом внутрь C1; failed — закрытие C2 снаружи, торгуем пробой
CRT_VARIANT=classic
# диапазон C1 не меньше N ATR старшего ТФ / тело C1 не больше доли диапазона
CRT_MIN_RANGE_ATR=0.8
CRT_MAX_BODY=0.85
# прокол C2 не глубже N доли диапазона C1 (иначе стоп слишком широкий)
CRT_MAX_SWEEP=0.40
# минимальный R:R до противоположной границы и до середины (для частичного)
CRT_MIN_RR=1.0
CRT_MIN_R1=0.30
# буфер стопа в ATR рабочего ТФ
CRT_STOP_BUF=0.25
# свип обеих границ за одну свечу — не сетап (0 = брать более глубокий свип)
CRT_DUAL_FILTER=1
# C1 должна быть против направления сделки (0 = цвет не важен)
CRT_C1_COLOR=0
# доля, закрываемая на середине диапазона (остаток — на противоположной границе)
CRT_P1=0.5
# цель варианта failed, в R; максимум баров в сделке
CRT_TP_R=1.0
CRT_MAX_BARS=120
# окно торговли по времени сервера, "0800-1700"; пусто = выключено
CRT_SESSION=
# --- структурные стоп/тейк по сильным уровням старшего ТФ (range_v2) ---
# sweep — стоп за свипом C2; level — за ближайшим сильным уровнем
CRT_SL_MODE=sweep
# range — тейк на противоположной границе C1; zone — на ближайшей сильной зоне
CRT_TP_MODE=range
# сила уровня: минимум касаний и сколько баров живёт перевёрнутый уровень
CRT_LEVEL_TOUCHES=2
CRT_LEVEL_FLIP_KEEP=0
# коридор стопа относительно уровня, в ATR рабочего ТФ (ближе — шум)
CRT_STOP_MIN_ATR=0.5
CRT_STOP_MAX_ATR=3.0
# коридор тейка по зоне, в R от входа (ближе — не цель)
CRT_TP_MIN_R=1.0
CRT_TP_MAX_R=4.0
# минимальная дистанция стопа в ATR рабочего ТФ: микро-стоп после гэпа при
# фиксированном риске на сделку даёт спред в десятки R
CRT_MIN_RISK_ATR=0.15
# --- денежная симуляция в crt.py (фиксированный риск на сделку) ---
# стартовый банк и риск на сделку, % от текущего баланса
CRT_BANK=5000
CRT_RISK_PCT=0.5
# спред в цене инструмента; пусто — взять текущий из MT5
CRT_SPREAD=

# ---- SMT-подтверждение (только range) ----
# окно баров рабочего ТФ, 0 = выключено; применяется только к символу SMT_FOR
SMT_LOOK=0
SMT_SYMBOL=XAGUSD
SMT_FOR=XAUUSD

# ---- Ежемесячный отчёт (autoposts) ----
MONTH_SUMMARY_ENABLED=1
MONTH_SUMMARY_TIME=12:00
# ---- Консенсус внешних источников (внутренний фильтр) ----
# Бот не читает чужие каналы. Сигналы попадают в consensus_signals.jsonl
# только вручную (python consensus.py add/ingest) или через POST /consensus/{secret}.
# warn — писать в лог, filter — пропускать вход при конфликте источников.
CONSENSUS_ENABLED=0
CONSENSUS_MODE=warn
# сколько независимых источников должны согласиться, чтобы голос учитывался
CONSENSUS_MIN_AGREE=2
# окно, в котором живёт голос, и максимальный возраст записей
CONSENSUS_WINDOW_MIN=60
CONSENSUS_MAX_AGE_MIN=240
# белый список источников через запятую; пусто — учитывать все присланные
CONSENSUS_SOURCES=
# блокировать ли вход при конфликте (действует только в режиме filter)
CONSENSUS_BLOCK_CONFLICT=1
# путь к хранилищу голосов; пусто — consensus_signals.jsonl в корне
CONSENSUS_PATH=

# ---- Research-гейт для идей из внешних источников ----
# минимум OOS-сделок и доля фолдов в плюсе для допуска идеи к кандидатам
RESEARCH_MIN_TRADES=20
RESEARCH_MIN_POS_FOLDS=0.6
# путь к реестру идей; пусто — research.json в корне
RESEARCH_PATH=

# ---- Discord-приём (официальный Bot API; discord_intake.py) ----
# Бот слушает только перечисленные id каналов. Пусто — не слушает ничего.
# Нужны права Read Messages/History и включённый Message Content Intent
# в Developer Portal. Текст разбирается сразу, скриншоты — через OCR.
DISCORD_INTAKE_ENABLED=0
DISCORD_TOKEN=
DISCORD_CHANNELS=
# присылать владельцу алерт о нераспознанном посте
DISCORD_REVIEW_ALERT=1
# Каналы с разборами сделок (ветки профит/убыток) — не голоса, а корпус для
# research: сообщения архивируются в discord_trades.jsonl. Достаточно id
# родительского канала: ветки подхватываются по parent_id.
DISCORD_ARCHIVE_CHANNELS=

# ---- Ретеншн файлов (tools/prune.py) ----
# Чистятся renders/, tg_screenshots/, discord_inbox/, preview/ —
# только обычные файлы старше PRUNE_DAYS. Расписание — autoposts.py.
PRUNE_ENABLED=1
PRUNE_TIME=04:00
PRUNE_DAYS=30
